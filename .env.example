# Public deployment origin. No trailing slash.
APP_BASE_URL=http://localhost:3000

# Admin and webhook boundaries.
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
WEBHOOK_SECRET=replace-with-a-rotatable-random-secret

# Base64-encoded 32-byte AES key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-key

# GitHub App configuration.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_CLIENT_ID=Iv1.example
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Slack app configuration. Keep Slack token rotation disabled for this MVP.
SLACK_CLIENT_ID=123456789.123456789
SLACK_CLIENT_SECRET=replace-with-slack-client-secret
DEMO_SLACK_CHANNEL_ID=C0123456789

# Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional local version label. Vercel uses VERCEL_GIT_COMMIT_SHA automatically.
NEXT_PUBLIC_APP_VERSION=local
